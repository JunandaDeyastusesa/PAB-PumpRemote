{
  "expo": {
    "name": "Irrigo",
    "slug": "PumpRemote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Irigo-BG.png",
    "scheme": "irrigo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Irigo-BG.png",
        "backgroundColor": "#F8FEFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.junanda.PumpRemote"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40a698f0-ba78-4271-abad-03a9f2c44a41"
      }
    }
  }
}